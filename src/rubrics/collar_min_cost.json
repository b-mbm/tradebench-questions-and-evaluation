  "range_fields": {
    "net_cost_per_btc": {
      "min": -80,
      "max": -40,
      "tolerance": 0,
      "strict": false,
      "description": "Acceptable collar net premium (USD per BTC). Values outside this band receive zero credit but still must respect automatic fail limits."
    }
  },
  "automatic_fail_conditions": [
    {
      "condition": "call_strike != 49500",
      "reason": "Selecting a lower strike caps upside too aggressively relative to historical distribution."
    },
    {
      "condition": "put_strike != 40500",
      "reason": "Higher put strikes overspend on skewed volatility and violate the cost constraint."
    },
    {
      "condition": "net_cost_per_btc > 0",
      "reason": "Net credit indicates over-reliance on upside cap and conflicts with minimizing total economic cost."
    },
    {
      "condition": "net_cost_per_btc < -100",
      "reason": "Net debit beyond $100/BTC overpays for protection given skew constraints."
    }
  ],
  "pass_threshold": 0.7,
  "metadata": {
    "category": "conditional_reasoning",
    "subcategory": "options_strategy",
    "description": "Assess whether the response selects the 10% OTM call and 10% OTM put collar that balances cost, skew, and upside capture."
  }
